# Copy to deploy/.env and fill in. Never commit the filled file.
# Portal and API (the marketing site lives on hidaaco.com)
DOMAIN=app.hidaaco.com

# Database
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
BACKUP_PASSPHRASE=
BACKUP_KEEP_DAYS=14

# Sessions and token encryption: openssl rand -base64 48 / openssl rand -base64 32
JWT_SECRET=
TOKEN_ENC_KEY=

# Meta (WhatsApp Cloud API + Embedded Signup) — docs/meta-integration.md
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
WA_VERIFY_TOKEN=
WA_REGISTRATION_PIN=
# Approved message templates (names), blank until approved
AGENT_HANDOFF_TEMPLATE=
AGENT_REMINDER_TEMPLATE=
AGENT_FOLLOWUP_TEMPLATE=
REPORT_TEMPLATE=

# Gemini (paid tier only: customer chats must not be used for training)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# Moyasar (sk_test_… first, then sk_live_…)
MOYASAR_SECRET_KEY=

# Operator console token: openssl rand -hex 24
ADMIN_TOKEN=

# Optional error tracking
SENTRY_DSN=

# Support form email forwarding (any SMTP provider: Zoho Mail, Google Workspace, Resend, Amazon SES…)
# Blank MAIL_HOST = messages are kept and listed at /admin/support, and sent once mail is configured.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SUPPORT_FORWARD_TO=faisal@hidaaco.com
SUPPORT_FROM=no-reply@hidaaco.com
